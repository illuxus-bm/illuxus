# Supabase connection (required)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# ---------------------------------------------------------------------------
# Public domain (optional)
#
# When set, every "Copy URL" / "Open" / "Preview" / share-link generator in
# the dashboard will produce URLs against this host instead of the host the
# dashboard is currently rendered on.
#
#   VITE_PUBLIC_DOMAIN          Pinned canonical host without protocol.
#                               Example: "illuxus.com" or "www.illuxus.com".
#                               Leave blank to use window.location.host —
#                               the safest default. With this blank, share
#                               links produced on a Vercel preview deploy
#                               are preview links, share links produced on
#                               production are production links, etc.
#
#   VITE_PUBLIC_PUBLISHED_HOST  Optional secondary host. Used as a fallback
#                               canonical host when VITE_PUBLIC_DOMAIN is
#                               blank but you still want a fixed URL target.
#                               Leave blank in most cases.
#
#   VITE_PUBLIC_ORIGIN          Full origin (with protocol) used by the
#                               speaker/attendee join-link builder in
#                               src/lib/publicUrl.ts. If unset, falls back
#                               to window.location.origin. Set this in
#                               production if you want join links to always
#                               point at your branded domain.
# ---------------------------------------------------------------------------
# VITE_PUBLIC_DOMAIN=""
# VITE_PUBLIC_PUBLISHED_HOST=""
# VITE_PUBLIC_ORIGIN=""

# Optional: LiveKit (for webinar feature — set in Supabase dashboard secrets)
# LIVEKIT_API_KEY="your-livekit-api-key"
# LIVEKIT_API_SECRET="your-livekit-api-secret"
# LIVEKIT_WS_URL="wss://your-livekit-instance.livekit.cloud"

# ---------------------------------------------------------------------------
# Email — Resend (Supabase Edge Function secrets, NOT in the client bundle)
#
# Set these in Supabase Dashboard → Project Settings → Edge Functions → Secrets
# (or via `supabase secrets set` when using the CLI).
#
#   RESEND_API_KEY="re_xxxxxxxx"           — from https://resend.com/api-keys
#   RESEND_FROM_EMAIL="Illuxus <noreply@yourdomain.com>"
#                                          — must use a domain verified in Resend
#
# After verifying your domain in Resend, flip the singleton row in
# `email_settings.domain_configured` to true (Supabase SQL editor):
#   UPDATE public.email_settings SET domain_configured = true WHERE singleton = true;
#
# Auth emails (signup OTP, 2FA, password reset) are sent by Supabase Auth.
# Configure Auth → SMTP Settings in the Supabase dashboard to use Resend SMTP:
#   Host: smtp.resend.com   Port: 465 (SSL) or 587 (TLS)
#   User: resend            Password: <your RESEND_API_KEY>
#   Sender: noreply@yourdomain.com
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Webinar provider switch (Agora migration foundation)
#
# `livekit` (default) keeps the existing LiveKit-backed webinar studio.
# `agora` routes every live event through the new Agora pipeline. Until
# the migration is feature-complete, leave this on `livekit` for shared
# environments and only flip individual events to `agora` for canary
# testing via the per-event `events.video_provider` column.
#
#   VITE_WEBINAR_PROVIDER=livekit
#   VITE_AGORA_APP_ID=""              # public — embedded in the client bundle
#
# Server-side Agora secrets (Supabase dashboard secrets, NOT committed
# to .env files for production deployments):
#
#   AGORA_APP_ID=""                   # same as VITE_AGORA_APP_ID
#   AGORA_APP_CERTIFICATE=""          # token signing cert; never expose to client
#   AGORA_CUSTOMER_KEY=""             # Cloud Recording REST auth (RESTful API)
#   AGORA_CUSTOMER_SECRET=""          # Cloud Recording REST auth
#   AGORA_REGION=""                   # optional, e.g. "ap-south-1"
# ---------------------------------------------------------------------------
# VITE_WEBINAR_PROVIDER="livekit"
# VITE_AGORA_APP_ID=""

# Observability — Sentry (or compatible) DSN. Empty = no remote reporting.
VITE_OBSERVABILITY_DSN=""

# Set to '1' to opt the entire build out of remote observability (rare; per-user opt-out is preferred).
VITE_OBSERVABILITY_OPT_OUT=""

# ---------------------------------------------------------------------------
# CI-only observability secrets (build-time source-map upload).
#
# These MUST NOT be Vite-prefixed (no `VITE_` prefix) because they are
# build-only secrets and must never be inlined into the client bundle.
# They are read from the Node process environment by the build pipeline
# (e.g., @sentry/vite-plugin) and used solely to upload source maps and
# associate them with a release. They are never referenced from `src/`.
#
#   OBSERVABILITY_AUTH_TOKEN  Auth token for the observability provider's
#                             release / source-map upload API. Treat as a
#                             secret (do not commit, do not expose to the
#                             browser).
#   OBSERVABILITY_ORG         Organization slug for the observability
#                             provider (used to scope the release upload).
#   OBSERVABILITY_PROJECT     Project slug for the observability provider
#                             (used to scope the release upload).
#
# Configure these in your CI provider's secret store. Local dev does not
# need them — when absent, source-map upload is skipped with a single
# warning and the build still succeeds.
# ---------------------------------------------------------------------------
# OBSERVABILITY_AUTH_TOKEN=""
# OBSERVABILITY_ORG=""
# OBSERVABILITY_PROJECT=""

# ---------------------------------------------------------------------------
# Edge function CORS allowlist (Supabase secret, NOT a Vite env)
# ---------------------------------------------------------------------------
# Every edge function under supabase/functions/ now uses an origin allowlist
# instead of the previous wildcard CORS. Set ALLOWED_ORIGINS as a Supabase
# Edge Function secret (Project Settings → Edge Functions → Secrets) to a
# comma-separated list of origins permitted to call the functions from a
# browser:
#
#   ALLOWED_ORIGINS="https://illuxus.com,https://www.illuxus.com,https://staging.illuxus.com"
#
# The allowlist also auto-includes whatever VITE_PUBLIC_DOMAIN /
# VITE_PUBLIC_PUBLISHED_HOST resolve to (so you don't have to repeat them)
# plus localhost:5173 / 8080 for local dev.
#
# Three functions are intentionally exempt and continue to allow any origin
# because they're hit by third-party servers or public pages, not browsers
# under our control:
#
#   - supabase/functions/whatsapp-webhook  (Meta posts here)
#   - supabase/functions/livekit-webhook   (LiveKit posts here)
#   - supabase/functions/org-events        (public embed.js on third-party sites)
#   - supabase/functions/fx-rates          (public read of cached USD rates)
# ---------------------------------------------------------------------------
# ALLOWED_ORIGINS=""

# ===========================================================================
# PREVIOUSLY-UNDOCUMENTED VARIABLES
#
# Everything below is read somewhere in the codebase but was missing from this
# file. A var that code reads and this file omits is a silent production
# failure: the feature degrades or throws at runtime with no build-time signal,
# because nothing validates env presence at startup.
#
# Grouped by WHERE the value must be set — that differs per group and is the
# most common source of "I set it and it still doesn't work".
# ===========================================================================

# ---------------------------------------------------------------------------
# GROUP 1 — Vite client bundle. Set in Vercel → Project → Environment
# Variables. MUST be prefixed VITE_ or Vite will not expose them, and NOTHING
# secret belongs here: every VITE_ var is inlined into the public JS bundle.
# ---------------------------------------------------------------------------

# Alternate spelling of VITE_SUPABASE_PUBLISHABLE_KEY. Three names for the
# same anon credential exist across the codebase:
#   VITE_SUPABASE_PUBLISHABLE_KEY  primary, read by src/integrations/supabase/client.ts
#   VITE_SUPABASE_ANON_KEY         fallback in src/lib/fx.ts, and the ONLY
#                                  source in page-builder/OrgPageForm.tsx
#                                  (which defaults to "" — so if you set only
#                                  the PUBLISHABLE name, that component
#                                  silently gets an empty key)
#   PUBLIC_SUPABASE_ANON_KEY       Vercel serverless (group 2 below)
# Set VITE_SUPABASE_ANON_KEY to the same value as VITE_SUPABASE_PUBLISHABLE_KEY
# until the naming is unified.
# VITE_SUPABASE_ANON_KEY=""

# Analytics. Absent = the script tags in src/components/SiteHead.tsx never
# render, so GA4 / Clarity collect nothing. Not an error, just silent no-op.
# VITE_GA4_ID=""
# VITE_CLARITY_ID=""

# Agora App ID for the in-house webinar studio. Required when
# VITE_WEBINAR_PROVIDER=agora. Public by design (the App *Certificate* is the
# secret and lives only in the edge function — see AGORA_APP_CERTIFICATE).
# VITE_AGORA_APP_ID=""

# NOTE: VITE_BUILD_SHA is NOT an environment variable. vite.config.ts injects
# it at build time from `git rev-parse --short HEAD`, falling back to
# "unknown". Setting it here has no effect. It becomes "unknown" when git
# history is unavailable at build time (e.g. a shallow clone), which breaks
# release correlation in the observability provider.

# ---------------------------------------------------------------------------
# GROUP 2 — Vercel serverless functions (api/*.ts). Set in the SAME Vercel env
# UI as group 1, but these are read via process.env and are NOT VITE_-prefixed,
# so they are not inlined into the client bundle.
# ---------------------------------------------------------------------------

# Read by api/event-og.ts for the server-rendered OG meta tags. When absent,
# link previews fall back to the generic card.
# PUBLIC_SUPABASE_URL=""
# PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# GROUP 3 — Supabase Edge Function secrets.
#
# ⚠️  These do NOT belong in Vercel. Set them in
#     Supabase Dashboard → Project Settings → Edge Functions → Secrets
#     or:  supabase secrets set KEY=value
#
# Putting them in Vercel is the single most common misconfiguration here: the
# build succeeds, the site loads, and then email/WhatsApp/AI silently 500.
# ---------------------------------------------------------------------------

# ── SMTP — the real email transport ────────────────────────────────────────
# The most-referenced secrets in the entire repo (SMTP_USERNAME appears 34
# times) and they were entirely undocumented — only the Resend HTTP path above
# was described. Every send-* function checks smtpConfigured() and returns HTTP
# 500 with "Email not configured" when these are unset, so ALL outbound email
# fails closed without them.
# SMTP_HOST=""          # e.g. smtp.gmail.com
# SMTP_PORT=""          # 465 (implicit TLS) or 587 (STARTTLS)
# SMTP_USERNAME=""      # full mailbox address
# SMTP_PASSWORD=""      # app-specific password, NOT the account password
# SMTP_FROM=""          # e.g. "Illuxus <noreply@yourdomain.com>"

# Distinct from RESEND_FROM_EMAIL documented earlier in this file. Both names
# are read in different functions.
# RESEND_FROM=""

# ── Public URL builders (edge-function side) ────────────────────────────────
# Non-VITE twins of the client vars at the top of this file. Used to build
# absolute links inside emails, and read by _shared/cors.ts to auto-populate
# the CORS allowlist. If unset, emailed links may point at the wrong host.
# PUBLIC_DOMAIN=""
# PUBLIC_PUBLISHED_HOST=""

# ── Gemini (AI creative generation) ────────────────────────────────────────
# GEMINI_API_KEY required by generate-creative-background (Imagen, images) and
# generate-creative-copy (text). Both return HTTP 500 code:"configuration"
# when it is absent — they fail closed, they do not fall back.
# GEMINI_API_KEY=""
# GEMINI_COPY_MODEL=""              # default: gemini-1.5-flash-latest
# GEMINI_COPY_DAILY_QUOTA=""        # default: 50  (copy drafts per event / 24h)
# GEMINI_PER_EVENT_DAILY_QUOTA=""   # default applies to background images

# ── WhatsApp Business (Meta Cloud API) ─────────────────────────────────────
# WHATSAPP_APP_SECRET is SECURITY-RELEVANT: whatsapp-webhook verifies Meta's
# X-Hub-Signature-256 HMAC against it and returns 401 when it is unset. Do not
# deploy the webhook without it — that check is the only thing authenticating
# inbound webhook traffic.
# WHATSAPP_TOKEN=""
# WHATSAPP_APP_SECRET=""
# WHATSAPP_VERIFY_TOKEN=""          # must match the value entered in Meta's dashboard
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# WHATSAPP_API_VERSION=""           # e.g. v21.0

# ── Agora App Certificate (SECRET — never expose to the browser) ───────────
# Used by the agora-token edge function to sign RTC/RTM tokens. This is the
# counterpart to the public VITE_AGORA_APP_ID. If this leaks, anyone can mint
# valid tokens for your Agora project.
# AGORA_APP_ID=""
# AGORA_APP_CERTIFICATE=""

# ── Misc edge-function config ──────────────────────────────────────────────
# SUPPORT_INBOX_EMAIL   destination for submit-support-ticket notifications
# VENDOR_PORTAL_URL     base URL used in notify-venue-selection emails
# SUPPORT_INBOX_EMAIL=""
# VENDOR_PORTAL_URL=""

# NOTE: SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
# injected automatically into every edge function by the Supabase platform.
# Do not set them manually.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses ALL row-level security. It must never
# appear in src/ or api/ — only in supabase/functions/. Verified clean at the
# time of writing, and the CI workflow's "service-role edge functions verify
# caller identity" gate keeps any function holding it honest.

# ---------------------------------------------------------------------------
# Support-form rate limiting (Supabase Edge Function secrets, both optional)
#
# `submit-support-ticket` is public and unauthenticated (verify_jwt = false)
# and sends two emails per accepted submission, so it throttles per IP by
# counting that IP's own recent tickets via the salted `ip_hash` column.
#
# Defaults: 5 submissions per 15 minutes per IP. Tuned so a real person who
# files a ticket, notices a typo, and files again never hits it.
#
# Both are optional. Malformed or non-positive values fall back to the
# defaults rather than disabling the limiter. The check fails OPEN — if the
# count query errors the submission is allowed, because a broken throttle must
# never silently swallow a genuine support request.
#
#   SUPPORT_RATE_LIMIT_MAX             max submissions per window (default 5)
#   SUPPORT_RATE_LIMIT_WINDOW_MINUTES  window length in minutes  (default 15)
# ---------------------------------------------------------------------------
# SUPPORT_RATE_LIMIT_MAX=""
# SUPPORT_RATE_LIMIT_WINDOW_MINUTES=""

# ---------------------------------------------------------------------------
# SMTP retry policy (Supabase Edge Function secrets, both optional)
#
# Sends used to be a single attempt, so one transient blip (connection reset,
# a relay's momentary 421, a DNS hiccup) permanently marked the recipient
# `failed` in `communication_recipients.email_status` with no retry and no log.
# On a large campaign that quietly loses real mail.
#
# `sendViaSmtp` now retries, but ONLY for errors classified transient by
# `supabase/functions/_shared/smtp-retry.ts`:
#   retried      4yz replies (421/450/451/452/454) and transport-level
#                failures (ECONNRESET, ETIMEDOUT, EAI_AGAIN, TLS, timeouts)
#   NOT retried  5yz replies (550 unknown mailbox, 554 spam reject), auth and
#                configuration failures, and anything unrecognised
#
# Retrying a hard bounce would burn the batch's time budget and damage sender
# reputation with the relay, so the classifier fails fast on anything it does
# not positively recognise as transient.
#
# Keep the budget small. `send-communication-email` loops a batch inside ONE
# edge-function invocation, which has a wall-clock limit, so the worst case has
# to stay bounded. Defaults add at most ~600ms plus jitter per recipient, and
# only for recipients that actually fail transiently. Backoff is exponential
# with jitter and clamped at 5s per wait.
#
#   SMTP_MAX_ATTEMPTS    total attempts per email (default 3, hard cap 5)
#   SMTP_RETRY_BASE_MS   first backoff in ms      (default 200, hard cap 2000)
#
# Malformed or non-positive values fall back to the defaults rather than
# disabling retries.
# ---------------------------------------------------------------------------
# SMTP_MAX_ATTEMPTS=""
# SMTP_RETRY_BASE_MS=""
