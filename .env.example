# Copy to .env.local and fill in. Never commit real values.

# ── Web app (exposed to the browser: public values only) ─────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Live video: "livekit" (default: our own server) or "agora" (earlier hosted stage).
VITE_WEBINAR_PROVIDER=livekit
VITE_AGORA_APP_ID=
# Canonical site address (links, the native apps' API base).
VITE_PUBLIC_ORIGIN=https://illuxus.com
# Optional: analytics and error reporting, loaded only after cookie consent.
VITE_GA4_ID=
VITE_CLARITY_ID=
VITE_OBSERVABILITY_DSN=

# Prisma API rollout (docs/PRISMA_MIGRATION.md). "supabase" (default) keeps
# every screen on direct Supabase queries; "api" sends migrated screens
# through /api/v1, falling back to Supabase if the API is unavailable.
VITE_DATA_BACKEND=supabase
# VITE_API_BASE_URL=https://illuxus.com

# ── Prisma API (server only: Vercel project settings, never VITE_*) ──────────
# AWS RDS:  postgresql://illuxus_api:<password>@<instance>.<region>.rds.amazonaws.com:5432/illuxus?sslmode=verify-full
# Supabase: the session pooler string from Project Settings → Database.
DATABASE_URL=
# AWS RDS's CA bundle (PEM) for verified TLS: https://truststore.pki.rds.amazonaws.com/<region>/<region>-bundle.pem
DATABASE_SSL_CA=
DATABASE_POOL_MAX=3
# Access tokens are verified against this project's published signing keys.
SUPABASE_URL=https://<project-ref>.supabase.co
# Only while the project still signs tokens with the legacy HS256 secret.
AUTH_JWT_SECRET=
# Extra browser origins allowed to call the API (comma-separated), e.g. previews.
API_ALLOWED_ORIGINS=
# Schema owner's connection, for the edge functions' service-role work on
# AWS RDS (service_role can't bypass row security there). Unset on Supabase.
DATABASE_SERVICE_URL=

# Ported edge functions (server/functions) read the same secrets as on Supabase:
# SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY, SMTP_HOST, SMTP_PORT,
# SMTP_USERNAME, SMTP_PASSWORD, SMTP_FROM, GEMINI_API_KEY, LIVEKIT_API_KEY,
# LIVEKIT_API_SECRET, LIVEKIT_WS_URL, AGORA_APP_ID, AGORA_APP_CERTIFICATE,
# WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_BUSINESS_ACCOUNT_ID,
# WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN, ALLOWED_ORIGINS, …

# Webinar viewers over HLS. Set to the public (CDN) address of the storage
# LiveKit Egress writes to, e.g. https://live.example.com, and viewers watch
# <base>/<room>/hls/live.m3u8 instead of joining the room. Unset, every
# viewer joins the LiveKit room. Storage itself is configured on the egress
# service, as for recordings.
WEBINAR_HLS_PUBLIC_BASE=

# Database jobs (api/v1/jobs) for AWS RDS. Leave DB_JOBS_ENABLED unset while
# the database is on Supabase: its pg_cron and pg_net already do this.
CRON_SECRET=
DB_JOBS_ENABLED=
