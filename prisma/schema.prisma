  utm_links                                                             utm_links[]
  utm_partner_access_utm_partner_access_granted_byTousers               utm_partner_access[]            @relation("utm_partner_access_granted_byTousers")
  utm_partner_access_utm_partner_access_partner_user_idTousers          utm_partner_access[]            @relation("utm_partner_access_partner_user_idTousers")
