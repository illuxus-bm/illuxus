  certificate_template_versions                                         certificate_template_versions[]
  certificate_templates                                                 certificate_templates[]
  certificates_certificates_issued_byTousers                            certificates[]                  @relation("certificates_issued_byTousers")
  certificates_certificates_revoked_byTousers                           certificates[]                  @relation("certificates_revoked_byTousers")
  communication_recipients                                              communication_recipients[]
  communications                                                        communications[]
  communities                                                           communities[]
  community_bookmarks                                                   community_bookmarks[]
  community_comments                                                    community_comments[]
  community_connections_community_connections_requester_idTousers       community_connections[]         @relation("community_connections_requester_idTousers")
  community_connections_community_connections_target_idTousers          community_connections[]         @relation("community_connections_target_idTousers")
  community_members                                                     community_members[]
  community_messages                                                    community_messages[]
  community_poll_votes                                                  community_poll_votes[]
  community_posts                                                       community_posts[]
  community_reactions                                                   community_reactions[]
  community_reports_community_reports_reporter_idTousers                community_reports[]             @relation("community_reports_reporter_idTousers")
  community_reports_community_reports_resolved_byTousers                community_reports[]             @relation("community_reports_resolved_byTousers")
  community_resources                                                   community_resources[]
  community_user_badges                                                 community_user_badges[]
  event_creative_ai_drafts                                              event_creative_ai_drafts[]
  event_emails                                                          event_emails[]
  event_venue_selections                                                event_venue_selections[]
  events                                                                events[]
  org_invitations                                                       org_invitations[]
  people                                                                people?
  profile_suggestion_dismissals                                         profile_suggestion_dismissals[]
  profiles                                                              profiles?
  registrant_audit_log                                                  registrant_audit_log[]
  registrations                                                         registrations[]
  speaker_applications                                                  speaker_applications[]
  sponsor_applications                                                  sponsor_applications[]
  sponsor_meeting_interests_sponsor_meeting_interests_created_byTousers sponsor_meeting_interests[]     @relation("sponsor_meeting_interests_created_byTousers")
  sponsor_meeting_interests_sponsor_meeting_interests_status_byTousers  sponsor_meeting_interests[]     @relation("sponsor_meeting_interests_status_byTousers")
  support_ticket_messages                                               support_ticket_messages[]
  support_tickets_support_tickets_assigned_toTousers                    support_tickets[]               @relation("support_tickets_assigned_toTousers")
  support_tickets_support_tickets_user_idTousers                        support_tickets[]               @relation("support_tickets_user_idTousers")
  unban_requests_unban_requests_reviewed_byTousers                      unban_requests[]                @relation("unban_requests_reviewed_byTousers")
  unban_requests_unban_requests_user_idTousers                          unban_requests[]                @relation("unban_requests_user_idTousers")
