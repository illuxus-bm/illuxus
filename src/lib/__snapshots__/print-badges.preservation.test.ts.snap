    <div class="card basic">
      <div class="banner placeholder" style="height:28.799999999999997mm;font-size:7pt;padding:0 2.9000000000000004mm">DemoConf</div>
      <div class="body" style="padding:3.4800000000000004mm 2.9000000000000004mm;gap:1.2mm;align-items:center;text-align:center">
        <div class="org" style="font-size:5pt">Acme</div>
        <div class="event" style="font-size:8pt;margin-top:0.72mm">DemoConf</div>
        <div class="meta" style="font-size:5pt;margin-top:1.2mm"><span>Jul 4</span><span class="dot">·</span><span>Hall A</span></div>
        <div class="divider" style="margin:1.68mm 0"></div>
        <div class="name" style="font-size:11.200000000000001pt;font-family:'Poppins',Poppins,system-ui,sans-serif;font-weight:700;font-style:normal;color:#0f172a;text-align:center">Jane Doe</div>
        <div class="qr-wrap" style="width:24.36mm;height:24.36mm;margin-top:1.44mm">
          <img src="data:image/png;base64,QR(https://ev.example/j)" alt="QR" />
        </div>
      </div>
    </div>
  </div></body></html>"
