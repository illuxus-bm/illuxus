          <div class="company" style="font-size:15.24pt;margin-top:1.83mm;font-family:'Poppins',Poppins,system-ui,sans-serif;font-style:normal;text-align:center;">Acme Inc.</div>
          
        </div>
        <div class="ptype" style="height:19.81mm;background:#00a5b1;font-size:28.08pt;padding:0 6.095999999999999mm">ATTENDEE</div>
      </div>
    </div>
  
    <div class="card basic">
      <div class="inner">
