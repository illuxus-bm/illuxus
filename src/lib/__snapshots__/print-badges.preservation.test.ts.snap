        <div class="qr-wrap" style="width:36mm;height:36mm;margin-top:2.7432mm">
          <img src="data:image/png;base64,QR(https://ev.example/j)" alt="QR" />
        </div>
      </div>
    </div>
  
    <div class="card basic">
      <div class="banner placeholder" style="height:54.864mm;font-size:9.87552pt;padding:0 5.08mm">DemoConf</div>
      <div class="body" style="padding:6.096mm 5.08mm;gap:2.286mm;align-items:center;text-align:center">
