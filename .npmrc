# Vercel installs API-route dependencies via npm (the SPA itself is bun-built).
# `agora-rtm-sdk@2.2.4` declares a peer of `agora-rtc-sdk-ng@4.23.0` but we
# ship `^4.24.4`, which npm 7+ treats as a hard install error by default
# even though the runtime is fully compatible. Bun (used for the SPA build)
# already ignores this — match its behaviour so Vercel deploys don't ERESOLVE.
legacy-peer-deps=true
