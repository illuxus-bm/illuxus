# Copy to android/keystore.properties (git-ignored) and fill in, or set the
# matching ILLUXUS_UPLOAD_* environment variables in CI. See docs/MOBILE.md.
#
# Create the upload key once, and keep it (and these passwords) in the team's
# password manager. With Play App Signing, a lost upload key can be reset
# through the Play Console; it is still a slow process.
#
#   keytool -genkeypair -v -keystore illuxus-upload.jks -alias upload \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is relative to android/.
storeFile=../illuxus-upload.jks
storePassword=
keyAlias=upload
keyPassword=
